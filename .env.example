# TableTamer environment variables.
# The server does NOT load this file by itself: set these in your shell or in
# ecosystem.config.cjs (pm2). There is no database and no API.

# Port and address to listen on (defaults: 5000 and 127.0.0.1).
PORT=5000
HOST=127.0.0.1

# development (Vite dev server) or production (serve dist/public).
NODE_ENV=development

# Winston log file (default: logs/tabletamer.log).
LOG_FILE_PATH=logs/tabletamer.log
